        "### Kinematics Analyzer Implementation\n",
        "We explicitly import `mediapipe.python.solutions.pose` and `mediapipe.python.solutions.drawing_utils` to avoid common attribute resolution errors in Colab."
      ]
    },
    {
      "cell_type": "code",
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "8d3d4529",
        "outputId": "9a4b82f1-e9a7-450a-89ad-a6582a6f9abb"
      },
      "source": [
        "import cv2\n",
        "import numpy as np\n",
        "from ultralytics import YOLO\n",
        "\n",
        "def calculate_angle(a, b, c):\n",
        "    \"\"\"\n",
        "    Calculates the angle (in degrees) between three 2D/3D points.\n",
        "    b is the vertex/joint point (e.g., elbow).\n",
        "    \"\"\"\n",
        "    a = np.array(a)\n",
        "    b = np.array(b)\n",
        "    c = np.array(c)\n",
        "\n",
        "    # Vector calculations\n",
        "    ba = a - b\n",
        "    bc = c - b\n",
        "\n",
        "    cosine_angle = np.dot(ba, bc) / (np.linalg.norm(ba) * np.linalg.norm(bc))\n",
        "    angle = np.arccos(np.clip(cosine_angle, -1.0, 1.0))\n",
        "    return np.degrees(angle)\n",
        "\n",
        "class KinematicAnalyzer:\n",
        "    def __init__(self):\n",
        "        # Use YOLOv8-Pose model which detects human keypoints directly out of the box\n",
        "        self.pose_model = YOLO('yolov8n-pose.pt')\n",
        "\n",
        "    def analyze_frame(self, frame):\n",
        "        # Run pose detection\n",
        "        results = self.pose_model(frame, verbose=False)\n",
        "\n",
        "        annotated_frame = results[0].plot()  # Automatically draw skeleton overlay\n",
        "        kinematics_data = {}\n",
        "\n",
        "        # COCO Keypoints index map for human joints:\n",
        "        # Right Shoulder: 6, Right Elbow: 8, Right Wrist: 10\n",
        "        if results[0].keypoints is not None and len(results[0].keypoints.xy) > 0:\n",
        "            keypoints = results[0].keypoints.xy[0].cpu().numpy()  # Get first person detected\n",
        "\n",
        "            if len(keypoints) > 10:\n",
        "                shoulder = keypoints[6]  # Right Shoulder\n",
        "                elbow = keypoints[8]     # Right Elbow\n",
        "                wrist = keypoints[10]    # Right Wrist\n",
        "\n",
        "                # Ensure keypoints are detected (not [0, 0])\n",
        "                if not (np.all(shoulder == 0) or np.all(elbow == 0) or np.all(wrist == 0)):\n",
        "                    elbow_angle = calculate_angle(shoulder, elbow, wrist)\n",
        "                    kinematics_data['right_elbow_angle'] = elbow_angle\n",
        "\n",
        "                    # Annotate the calculated angle on the frame\n",
        "                    h, w, _ = frame.shape\n",
        "                    elbow_pixel = (int(elbow[0]), int(elbow[1]))\n",
        "                    cv2.putText(annotated_frame, f\"{int(elbow_angle)} Deg\",\n",
        "                                elbow_pixel, cv2.FONT_HERSHEY_SIMPLEX, 0.7, (0, 0, 255), 2)\n",
        "\n",
        "        return annotated_frame, kinematics_data\n",
        "\n",
        "print(\"Kinematic Analyzer (YOLO-Pose powered) successfully configured!\")"
      ],
