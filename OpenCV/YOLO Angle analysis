        "import pandas as pd\n",
        "import cv2\n",
        "\n",
        "# Re-extract the kinematics data into a structured format for review\n",
        "print(\"Aggregating frame-by-frame kinematics logs...\")\n",
        "cap = cv2.VideoCapture(sample_video_path)\n",
        "analyzer = KinematicAnalyzer()\n",
        "\n",
        "records = []\n",
        "frame_count = 0\n",
        "\n",
        "while cap.isOpened():\n",
        "    ret, frame = cap.read()\n",
        "    if not ret:\n",
        "        break\n",
        "\n",
        "    _, kinematics = analyzer.analyze_frame(frame)\n",
        "    angle = kinematics.get('right_elbow_angle', None)\n",
        "\n",
        "    records.append({\n",
        "        \"Frame\": frame_count,\n",
        "        \"Right_Elbow_Angle_Deg\": angle\n",
        "    })\n",
        "    frame_count += 1\n",
        "\n",
        "cap.release()\n",
        "\n",
        "# Convert to DataFrame\n",
        "df_kinematics = pd.DataFrame(records)\n",
        "\n",
        "# Filter out frames where the joint was not detected\n",
        "df_detected = df_kinematics.dropna().reset_index(drop=True)\n",
        "\n",
        "# Display the first few rows\n",
        "print(f\"\\nSummary: Joint detected in {len(df_detected)} out of {len(df_kinematics)} frames.\")\n",
        "display(df_detected.head(15))"
