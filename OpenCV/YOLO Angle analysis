      "source": [
        "import cv2\n",
        "import urllib.request\n",
        "\n",
        "# 1. Download a sample bowling action video (or replace this URL with your own local file path)\n",
        "video_url = \"https://github.com/intel-iot-devkit/sample-videos/raw/master/people-detection.mp4\"\n",
        "sample_video_path = \"sample_input.mp4\"\n",
        "output_video_path = \"analyzed_output.avi\"  # Switched to AVI for reliable writing in Colab\n",
        "\n",
        "print(\"Downloading sample video...\")\n",
        "urllib.request.urlretrieve(video_url, sample_video_path)\n",
        "print(\"Download complete.\")\n",
        "\n",
        "# 2. Open the video stream\n",
        "cap = cv2.VideoCapture(sample_video_path)\n",
        "if not cap.isOpened():\n",
        "    raise IOError(f\"Cannot open video file {sample_video_path}\")\n",
        "\n",
        "# Get video properties\n",
        "width = int(cap.get(cv2.CAP_PROP_FRAME_WIDTH))\n",
        "height = int(cap.get(cv2.CAP_PROP_FRAME_HEIGHT))\n",
        "fps = int(cap.get(cv2.CAP_PROP_FPS))\n",
        "total_frames = int(cap.get(cv2.CAP_PROP_FRAME_COUNT))\n",
        "\n",
        "# 3. Initialize Video Writer to save output using XVID codec\n",
        "fourcc = cv2.VideoWriter_fourcc(*'XVID')\n",
        "out = cv2.VideoWriter(output_video_path, fourcc, fps, (width, height))\n",
        "\n",
        "# 4. Instantiate our Kinematic Analyzer\n",
        "analyzer = KinematicAnalyzer()\n",
        "\n",
        "print(f\"Processing {total_frames} frames...\")\n",
        "frame_count = 0\n",
        "while cap.isOpened():\n",
        "    ret, frame = cap.read()\n",
        "    if not ret:\n",
        "        break\n",
        "\n",
        "    # Process the frame to draw landmarks and obtain calculated angles\n",
        "    annotated_frame, kinematics = analyzer.analyze_frame(frame)\n",
        "\n",
        "    # Optionally monitor calculations in stdout\n",
        "    if 'right_elbow_angle' in kinematics:\n",
        "        print(f\"Frame {frame_count}: Right Elbow Angle = {kinematics['right_elbow_angle']:.2f} Deg\")\n",
        "\n",
        "    # Save annotated frame\n",
        "    out.write(annotated_frame)\n",
        "    frame_count += 1\n",
        "\n",
        "# Release everything\n",
        "cap.release()\n",
        "out.release()\n",
        "cv2.destroyAllWindows()\n",
        "print(f\"Processing finished! Annotated video saved as: {output_video_path}\")"
      ],
